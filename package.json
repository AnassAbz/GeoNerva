{
  "name": "geonerva",
  "private": true,
  "description": "Open-source, explainable, location-specific natural-hazard intelligence.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @geonerva/web dev",
    "build": "pnpm --filter @geonerva/web build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps packages scripts --config .dependency-cruiser.cjs",
    "openapi": "node scripts/generate-openapi.ts",
    "bench:api": "node scripts/bench-api.ts",
    "soak": "node scripts/soak-report.ts",
    "smoke": "node scripts/smoke.ts",
    "geonames:import": "node scripts/import-geonames.ts",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @geonerva/web test:e2e",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait db",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:check": "node scripts/db-check.ts",
    "db:codegen": "node scripts/db-codegen.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm depcruise && pnpm test:unit && pnpm test:components",
    "build:canary": "node scripts/check-bundle-secrets.ts",
    "db:seed:scenario": "node scripts/seed-scenario.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@geonerva/config": "workspace:*",
    "@geonerva/db": "workspace:*",
    "@geonerva/test-fixtures": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
