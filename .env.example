# GeoNerva environment template. Copy to `.env` for local development.
# NEVER commit real secrets. Variables are validated at start-up by packages/config.
# See docs/ARCHITECTURE.md §15 for the full reference.

# ── Shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# lean (free-tier, 72 h thermal-detection replay horizon) | standard (≥ 8 GB database)
RETENTION_PROFILE=lean

# ── Testing only. Refused when NODE_ENV=production. ─────────────────────────
# Freezes the clock every process reads through `nowFrom` (docs/TESTING.md §5), so an E2E run
# against the seeded scenario database sees a world that is not ageing under it. Must be a full
# ISO 8601 instant with an offset; an unparseable value fails start-up rather than falling back to
# the wall clock. The value below is the anchor `pnpm db:seed:scenario` writes.
# GEONERVA_FAKE_NOW=2026-09-22T13:06:00.000Z
# The disposable database the integration suite and `pnpm db:seed:scenario` use. Must be on
# loopback and named `*_test`; `DATABASE_URL` is never consulted by them (security finding F-6).
# Both of them TRUNCATE what they are pointed at.
# DATABASE_URL_TEST=postgresql://geonerva:geonerva@127.0.0.1:54320/geonerva_test

# Accepts a test database on a **remote host**, for a CI runner whose database is not on loopback.
# It relaxes the host and nothing else: the name must still end in `_test`, because that is the
# half that says losing the database is acceptable (security review F-19).
# GEONERVA_ALLOW_REMOTE_TEST_DB=1

# ── Web (read-only Next.js app) ──────────────────────────────────────────────
# Transaction-pooled connection in production (Supabase port 6543, prepared statements disabled).
DATABASE_URL=postgresql://geonerva:geonerva@127.0.0.1:54320/geonerva
# ≥ 32 random characters, e.g. `openssl rand -hex 32`
RATE_LIMIT_SECRET=
# Contact (URL or e-mail) sent in the User-Agent to Nominatim, as its usage policy requires.
NOMINATIM_CONTACT=
# Optional. Defaults to the OpenFreeMap dark style.
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# ── Worker (ingestion; the only writer of provider facts) ────────────────────
# Session-mode or direct connection (needs prepared statements, long transactions, COPY).
DATABASE_URL_WORKER=postgresql://geonerva:geonerva@127.0.0.1:54320/geonerva
# Optional. Without it the worker uses the keyless FIRMS 24 h files (no backfill).
FIRMS_MAP_KEY=
# Optional. Only needed if the worker's HTTP trigger is enabled (≥ 32 characters).
# WORKER_TRIGGER_SECRET=
# Which build is running. Written to `worker_heartbeat.version` and `ingestion_runs.worker_version`,
# so a soak or an incident can say which build produced a failure rather than just "production".
# A plain identifier (a commit SHA, a tag, an image label), at most 64 characters. Unset in a
# checkout; set by the deployment manifests (docs/DEPLOYMENT.md).
# GEONERVA_BUILD=ef6e970

# ── Runtime AI (optional, P1). Production default for v1 is disabled. ───────
AI_MODE=disabled
# Required only when AI_MODE=anthropic.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_DAILY_BUDGET_USD=1
