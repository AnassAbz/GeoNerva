{
  "name": "@geonerva/db",
  "version": "0.0.0",
  "private": true,
  "description": "Migrations, typed query builder, repositories, as-of query layer and spatial SQL. The only package containing SQL.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node src/migrator/cli.ts",
    "codegen": "kysely-codegen --dialect postgres --out-file src/generated/database.ts",
    "estimate-storage": "node src/estimate-storage.ts"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0"
  }
}
